[Desktop Entry]
Name=Fluxer
GenericName=Instant Messenger
Comment=Instant messaging and VoIP application
Exec=fluxer %U
Icon=${SNAP}/usr/share/icons/hicolor/1024x1024/apps/fluxer.png
Type=Application
Terminal=false
StartupWMClass=app.fluxer.FluxerDesktop
Keywords=chat;im;messaging;messenger;voip;voice;video;call;
Categories=Network;InstantMessaging;Chat;
StartupNotify=true
SingleMainWindow=true
MimeType=x-scheme-handler/fluxer;
X-GNOME-UsesNotifications=true
Actions=open-settings;new-dm;

[Desktop Action open-settings]
Name=Open Settings
Exec=fluxer --fluxer-task=open-settings %U

[Desktop Action new-dm]
Name=New Direct Message
Exec=fluxer --fluxer-task=new-dm %U
